generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTITUTION
  INDUSTRY
  ADMIN
}

enum OpportunityType {
  INTERNSHIP
  JOB
  PROJECT
}

enum OpportunityStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

model User {
  id             String          @id @default(cuid())
  fullName       String
  email          String          @unique
  password       String
  phone          String?
  role           Role
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile?
  institution    Institution?
  company        Company?

  @@index([role, isActive])
}

model Institution {
  id            String           @id @default(cuid())
  userId        String           @unique
  name          String
  officialEmail String           @unique
  website       String?
  address       String?
  description   String?
  contactInfo   String?
  isVerified    Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students      StudentProfile[]

  @@index([isVerified])
}

model StudentProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  institutionId  String?
  degree         String?
  department     String?
  graduationYear Int?
  semester       Int?
  bio            String?
  profileImage   String?
  resumeUrl      String?
  linkedIn       String?
  github         String?
  portfolio      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([graduationYear])
}

// Integration anchor for Person 3: extend this model with opportunities and required skills.
model Company {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String
  officialEmail String   @unique
  website       String?
  address       String?
  description   String?
  contactInfo   String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([isVerified])
}

model Opportunity {
  id                   String            @id @default(cuid())
  companyId            String
  title                String
  type                 OpportunityType
  description          String
  responsibilities     String?
  qualifications       String?
  location             String?
  workMode             WorkMode?
  compensation         String?
  openings             Int               @default(1)
  applicationUrl       String?
  applicationDeadline  DateTime?
  startDate            DateTime?
  endDate              DateTime?
  status               OpportunityStatus @default(DRAFT)
  publishedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([type, status])
  @@index([applicationDeadline])
  @@index([createdAt])
}
