generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTITUTION
  INDUSTRY
  ADMIN
}

enum OpportunityType {
  INTERNSHIP
  JOB
  PROJECT
}

enum OpportunityStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillSource {
  MANUAL
  ASSESSMENT
  RESUME
}

model User {
  id             String          @id @default(cuid())
  fullName       String
  email          String          @unique
  password       String
  phone          String?
  role           Role
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile?
  institution    Institution?
  company        Company?

  @@index([role, isActive])
}

model Institution {
  id            String           @id @default(cuid())
  userId        String           @unique
  name          String
  officialEmail String           @unique
  website       String?
  address       String?
  description   String?
  contactInfo   String?
  isVerified    Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students      StudentProfile[]

  @@index([isVerified])
}

model StudentProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  institutionId  String?
  degree         String?
  department     String?
  graduationYear Int?
  semester       Int?
  bio            String?
  profileImage   String?
  resumeUrl      String?
  linkedIn       String?
  github         String?
  portfolio      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  skills         StudentSkill[]
  assessmentResults AssessmentResult[]
  recommendations LearningRecommendation[]

  @@index([institutionId])
  @@index([graduationYear])
}

model Skill {
  id          String        @id @default(cuid())
  name        String        @unique
  category    String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  students    StudentSkill[]
  assessments Assessment[]
  recommendations LearningRecommendation[]
  @@index([category, name])
}

model StudentSkill {
  id               String           @id @default(cuid())
  studentProfileId String
  skillId          String
  proficiencyLevel ProficiencyLevel
  source           SkillSource      @default(MANUAL)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@unique([studentProfileId, skillId])
  @@index([skillId, proficiencyLevel])
}

model Assessment {
  id             String               @id @default(cuid())
  skillId        String
  title          String
  description    String?
  totalQuestions Int                  @default(0)
  createdAt      DateTime             @default(now())
  skill          Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  questions      AssessmentQuestion[]
  results        AssessmentResult[]
  @@index([skillId])
}

model AssessmentQuestion {
  id            String     @id @default(cuid())
  assessmentId  String
  question      String
  options       String[]
  correctAnswer Int
  explanation   String?
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([assessmentId])
}

model AssessmentResult {
  id               String           @id @default(cuid())
  studentProfileId String
  assessmentId     String
  score            Int
  percentage       Float
  proficiencyLevel ProficiencyLevel
  completedAt      DateTime         @default(now())
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assessment       Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([studentProfileId, completedAt])
  @@index([assessmentId, completedAt])
}

model LearningRecommendation {
  id               String           @id @default(cuid())
  studentProfileId String
  skillId          String
  title            String
  description      String
  difficulty       ProficiencyLevel @default(BEGINNER)
  resourceUrl      String?
  priority         Int              @default(3)
  isCompleted      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@index([studentProfileId, isCompleted, priority])
}

// Integration anchor for Person 3: extend this model with opportunities and required skills.
model Company {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String
  officialEmail String   @unique
  website       String?
  address       String?
  description   String?
  contactInfo   String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([isVerified])
}

model Opportunity {
  id                   String            @id @default(cuid())
  companyId            String
  title                String
  type                 OpportunityType
  description          String
  responsibilities     String?
  qualifications       String?
  location             String?
  workMode             WorkMode?
  compensation         String?
  openings             Int               @default(1)
  applicationUrl       String?
  applicationDeadline  DateTime?
  startDate            DateTime?
  endDate              DateTime?
  status               OpportunityStatus @default(DRAFT)
  publishedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([type, status])
  @@index([applicationDeadline])
  @@index([createdAt])
}
